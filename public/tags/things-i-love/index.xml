img&#39;);&#xA;    var fc = a.parentNode.querySelector(&#39;figcaption&#39;);&#xA;    img.src = a.getAttribute(&#39;href&#39;);&#xA;    img.alt = thumb ? thumb.alt : &#39;&#39;;&#xA;    cap.textContent = fc ? fc.textContent : &#39;&#39;;&#xA;    prev.hidden = next.hidden = links.length &lt; 2;&#xA;    dlg.classList.remove(&#39;is-full&#39;);&#xA;  }&#xA;  function openAt(n) {&#xA;    collect();&#xA;    if (!dlg.open) dlg.showModal();&#xA;    show(n);&#xA;  }&#xA;&#xA;  document.addEventListener(&#39;click&#39;, function (e) {&#xA;    var a = e.target.closest &amp;&amp; e.target.closest(&#39;figure.gal-solo a.zoom&#39;);&#xA;    if (!a) return;&#xA;    e.preventDefault();&#xA;    e.stopImmediatePropagation();&#xA;    collect();&#xA;    openAt(links.indexOf(a));&#xA;  }, true);&#xA;&#xA;  closeBtn.addEventListener(&#39;click&#39;, function () { dlg.close(); });&#xA;  prev.addEventListener(&#39;click&#39;, function () { show(idx - 1); });&#xA;  next.addEventListener(&#39;click&#39;, function () { show(idx + 1); });&#xA;  img.addEventListener(&#39;click&#39;, function () { dlg.classList.toggle(&#39;is-full&#39;); });&#xA;&#xA;  dlg.addEventListener(&#39;click&#39;, function (e) {&#xA;    if (e.target === dlg || e.target.classList.contains(&#39;glb-scroll&#39;)) dlg.close();&#xA;  });&#xA;&#xA;  document.addEventListener(&#39;keydown&#39;, function (e) {&#xA;    if (!dlg.open) return;&#xA;    if (e.key === &#39;ArrowLeft&#39;) show(idx - 1);&#xA;    if (e.key === &#39;ArrowRight&#39;) show(idx + 1);&#xA;  });&#xA;&#xA;  var x0 = null;&#xA;  dlg.addEventListener(&#39;touchstart&#39;, function (e) { x0 = e.changedTouches[0].clientX; }, { passive: true });&#xA;  dlg.addEventListener(&#39;touchend&#39;, function (e) {&#xA;    if (x0 === null) return;&#xA;    var dx = e.changedTouches[0].clientX - x0;&#xA;    x0 = null;&#xA;    if (Math.abs(dx) &gt; 50) show(idx + (dx &lt; 0 ? 1 : -1));&#xA;  }, { passive: true });&#xA;&#xA;  dlg.addEventListener(&#39;close&#39;, function () { img.removeAttribute(&#39;src&#39;); });&#xA;})();&#xA;&lt;/script&gt;&#xA;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/balcony.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/balcony_hu_5d1bf0dd393fafe6.jpg&#34; alt=&#34;Balcony with a small table and railing&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Balcony at home&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/hometable.jpeg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/hometable_hu_75455d77db034adc.jpeg&#34; alt=&#34;Writing table at home with a typewriter&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Study table at home&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/inks.jpeg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/inks_hu_774f88efa585846a.jpeg&#34; alt=&#34;Row of ink bottles on a shelf&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Inks&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/laptop.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/laptop_hu_3c65bfdb2b254b1.jpg&#34; alt=&#34;Laptop open on a desk&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Laptop&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/notebook.jpeg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/notebook_hu_4063d97159a39c18.jpeg&#34; alt=&#34;Brown notebook with a patterned strip&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Notebook&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/officetable.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/officetable_hu_32d1a7cd23f854aa.jpg&#34; alt=&#34;Office desk with a monitor&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Office table&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/officetable2.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/officetable2_hu_74c04c1dc66d241c.jpg&#34; alt=&#34;Office desk with a pink cloth and notes on the wall&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Office table, another view&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/pen.jpeg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/pen_hu_14acd4bee413c3a6.jpeg&#34; alt=&#34;Green highlighter on a brown notebook&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Kakuno Ink Pen&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/shirts.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/shirts_hu_57ab4301fb70f00d.jpg&#34; alt=&#34;Shirts hanging out to dry&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Shirts&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/two.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/two_hu_98c96d89260a5fd7.jpg&#34; alt=&#34;Two people reflected in a train window&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Togetherness&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&lt;figure class=&#34;gal-solo gal-solo--text&#34;&gt;&lt;a class=&#34;zoom&#34; href=&#34;http://localhost:1313/now/typewriter.jpg&#34;&gt;&lt;img src=&#34;http://localhost:1313/now/typewriter_hu_bd6d398253a2ac5b.jpg&#34; alt=&#34;Vintage typewriter&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&lt;/a&gt;&lt;figcaption&gt;Typewriter&lt;/figcaption&gt;&lt;/figure&gt;&#xA;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;.img-grid {&#xA;  display: grid;&#xA;  gap: 1rem;&#xA;  grid-template-columns: 1fr;  &#xA;  margin-bottom: 2rem;&#xA;}&#xA;&#xA;@media (min-width: 600px) {&#xA;  .img-grid {&#xA;    grid-template-columns: repeat(2, 1fr);  &#xA;  }&#xA;}&#xA;&#xA;@media (min-width: 1024px) {&#xA;  .img-grid {&#xA;    grid-template-columns: repeat(3, 1fr);  &#xA;  }&#xA;}&#xA;&#xA;.img-grid figure {&#xA;  margin: 0;&#xA;}&#xA;&#xA;.img-grid img {&#xA;  width: 100%;&#xA;  height: auto;&#xA;  border-radius: 8px;&#xA;  display: block;&#xA;}&#xA;&#xA;.img-grid figcaption {&#xA;  font-size: 0.9rem;&#xA;  text-align: center;&#xA;  color: #555;&#xA;  margin-top: 0.3rem;&#xA;}&#xA;&lt;/style&gt;</description>
      <content:encoded><![CDATA[<p><strong>Note :</strong> This is living document where I will add things, places, moments, actvities I love.</p>
<hr>
<div class="img-grid">
  
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/activa.jpg"><img src="/now/activa_hu_9981eb875867f2e6.jpg" alt="Activa scooter under a large tree" loading="lazy" decoding="async"></a><figcaption>Activa Scooter</figcaption></figure><dialog class="glb" id="zoomviewer" aria-label="Image viewer">
  <div class="glb-scroll"><img alt=""></div>
  <button class="glb-x" type="button" aria-label="Close">Close ✕</button>
  <button class="glb-nav glb-prev" type="button" aria-label="Previous image">‹</button>
  <button class="glb-nav glb-next" type="button" aria-label="Next image">›</button>
  <p class="glb-cap"></p>
</dialog>
<script>
(function () {
  var dlg = document.getElementById('zoomviewer');
  if (!dlg || dlg.dataset.ready) return;
  dlg.dataset.ready = '1';

  var img = dlg.querySelector('img');
  var cap = dlg.querySelector('.glb-cap');
  var prev = dlg.querySelector('.glb-prev');
  var next = dlg.querySelector('.glb-next');
  var closeBtn = dlg.querySelector('.glb-x');
  var links = [], idx = 0;

  function collect() {
    links = [].slice.call(document.querySelectorAll('figure.gal-solo a.zoom'));
  }
  function show(n) {
    idx = (n + links.length) % links.length;
    var a = links[idx];
    var thumb = a.querySelector('img');
    var fc = a.parentNode.querySelector('figcaption');
    img.src = a.getAttribute('href');
    img.alt = thumb ? thumb.alt : '';
    cap.textContent = fc ? fc.textContent : '';
    prev.hidden = next.hidden = links.length < 2;
    dlg.classList.remove('is-full');
  }
  function openAt(n) {
    collect();
    if (!dlg.open) dlg.showModal();
    show(n);
  }

  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('figure.gal-solo a.zoom');
    if (!a) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    collect();
    openAt(links.indexOf(a));
  }, true);

  closeBtn.addEventListener('click', function () { dlg.close(); });
  prev.addEventListener('click', function () { show(idx - 1); });
  next.addEventListener('click', function () { show(idx + 1); });
  img.addEventListener('click', function () { dlg.classList.toggle('is-full'); });

  dlg.addEventListener('click', function (e) {
    if (e.target === dlg || e.target.classList.contains('glb-scroll')) dlg.close();
  });

  document.addEventListener('keydown', function (e) {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });

  var x0 = null;
  dlg.addEventListener('touchstart', function (e) { x0 = e.changedTouches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', function (e) {
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
  }, { passive: true });

  dlg.addEventListener('close', function () { img.removeAttribute('src'); });
})();
</script>

<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/balcony.jpg"><img src="/now/balcony_hu_5d1bf0dd393fafe6.jpg" alt="Balcony with a small table and railing" loading="lazy" decoding="async"></a><figcaption>Balcony at home</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/hometable.jpeg"><img src="/now/hometable_hu_75455d77db034adc.jpeg" alt="Writing table at home with a typewriter" loading="lazy" decoding="async"></a><figcaption>Study table at home</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/inks.jpeg"><img src="/now/inks_hu_774f88efa585846a.jpeg" alt="Row of ink bottles on a shelf" loading="lazy" decoding="async"></a><figcaption>Inks</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/laptop.jpg"><img src="/now/laptop_hu_3c65bfdb2b254b1.jpg" alt="Laptop open on a desk" loading="lazy" decoding="async"></a><figcaption>Laptop</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/notebook.jpeg"><img src="/now/notebook_hu_4063d97159a39c18.jpeg" alt="Brown notebook with a patterned strip" loading="lazy" decoding="async"></a><figcaption>Notebook</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/officetable.jpg"><img src="/now/officetable_hu_32d1a7cd23f854aa.jpg" alt="Office desk with a monitor" loading="lazy" decoding="async"></a><figcaption>Office table</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/officetable2.jpg"><img src="/now/officetable2_hu_74c04c1dc66d241c.jpg" alt="Office desk with a pink cloth and notes on the wall" loading="lazy" decoding="async"></a><figcaption>Office table, another view</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/pen.jpeg"><img src="/now/pen_hu_14acd4bee413c3a6.jpeg" alt="Green highlighter on a brown notebook" loading="lazy" decoding="async"></a><figcaption>Kakuno Ink Pen</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/shirts.jpg"><img src="/now/shirts_hu_57ab4301fb70f00d.jpg" alt="Shirts hanging out to dry" loading="lazy" decoding="async"></a><figcaption>Shirts</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/two.jpg"><img src="/now/two_hu_98c96d89260a5fd7.jpg" alt="Two people reflected in a train window" loading="lazy" decoding="async"></a><figcaption>Togetherness</figcaption></figure>
<figure class="gal-solo gal-solo--text"><a class="zoom" href="/now/typewriter.jpg"><img src="/now/typewriter_hu_bd6d398253a2ac5b.jpg" alt="Vintage typewriter" loading="lazy" decoding="async"></a><figcaption>Typewriter</figcaption></figure>

</div>

<style>
.img-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: 1fr;  
  margin-bottom: 2rem;
}

@media (min-width: 600px) {
  .img-grid {
    grid-template-columns: repeat(2, 1fr);  
  }
}

@media (min-width: 1024px) {
  .img-grid {
    grid-template-columns: repeat(3, 1fr);  
  }
}

.img-grid figure {
  margin: 0;
}

.img-grid img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}

.img-grid figcaption {
  font-size: 0.9rem;
  text-align: center;
  color: #555;
  margin-top: 0.3rem;
}
</style>

