3/things-i-love/hometable_hu_9668076ff01646fe.jpeg&#34; width=&#34;700&#34; height=&#34;600&#34; alt=&#34;Hometable&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&#xA;              &lt;/a&gt;&#xA;              &lt;figcaption&gt;Hometable&lt;/figcaption&gt;&#xA;            &lt;/figure&gt;&#xA;          &lt;/li&gt;&#xA;          &lt;li&gt;&#xA;            &lt;figure&gt;&#xA;              &lt;a class=&#34;ab-pic&#34; href=&#34;http://localhost:1313/things-i-love/balcony_hu_748b4e76a6f83114.jpg&#34; data-cap=&#34;Balcony&#34; aria-label=&#34;Enlarge: Balcony&#34;&gt;&#xA;                &lt;img src=&#34;http://localhost:1313/things-i-love/balcony_hu_8630cec1a4403491.jpg&#34; width=&#34;700&#34; height=&#34;396&#34; alt=&#34;Balcony&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&#xA;              &lt;/a&gt;&#xA;              &lt;figcaption&gt;Balcony&lt;/figcaption&gt;&#xA;            &lt;/figure&gt;&#xA;          &lt;/li&gt;&#xA;          &lt;li&gt;&#xA;            &lt;figure&gt;&#xA;              &lt;a class=&#34;ab-pic&#34; href=&#34;http://localhost:1313/things-i-love/activa_hu_af29d125e305b33c.jpg&#34; data-cap=&#34;Activa&#34; aria-label=&#34;Enlarge: Activa&#34;&gt;&#xA;                &lt;img src=&#34;http://localhost:1313/things-i-love/activa_hu_f854de7e6140932d.jpg&#34; width=&#34;700&#34; height=&#34;396&#34; alt=&#34;Activa&#34; loading=&#34;lazy&#34; decoding=&#34;async&#34;&gt;&#xA;              &lt;/a&gt;&#xA;              &lt;figcaption&gt;Activa&lt;/figcaption&gt;&#xA;            &lt;/figure&gt;&#xA;          &lt;/li&gt;&#xA;      &lt;/ul&gt;&#xA;    &lt;/section&gt;&lt;dialog class=&#34;ab-box&#34; aria-label=&#34;Picture viewer&#34;&gt;&#xA;    &lt;div class=&#34;ab-track&#34;&gt;&lt;/div&gt;&#xA;    &lt;div class=&#34;ab-head&#34;&gt;&#xA;      &lt;span class=&#34;ab-ttl&#34;&gt;&lt;/span&gt;&#xA;      &lt;button class=&#34;ab-x&#34; type=&#34;button&#34;&gt;Close ✕&lt;/button&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;button class=&#34;ab-nav ab-prev&#34; type=&#34;button&#34; aria-label=&#34;Previous picture&#34;&gt;‹&lt;/button&gt;&#xA;    &lt;button class=&#34;ab-nav ab-next&#34; type=&#34;button&#34; aria-label=&#34;Next picture&#34;&gt;›&lt;/button&gt;&#xA;    &lt;p class=&#34;ab-cap&#34;&gt;&lt;/p&gt;&#xA;  &lt;/dialog&gt;&#xA;&#xA;  &lt;script&gt;&#xA;  (function () {&#xA;    var root   = document.currentScript.parentElement;&#xA;    var home   = root.querySelector(&#39;.ab-home&#39;);&#xA;    var panels = Array.prototype.slice.call(root.querySelectorAll(&#39;.ab-album&#39;));&#xA;    var single = root.dataset.single === &#39;true&#39;;&#xA;&#xA;     &#xA;    var back = root.querySelector(&#39;.ab-back&#39;);&#xA;    var inPage = false;   &#xA;&#xA;    function sync(scroll) {&#xA;      if (single) return;&#xA;      var id = decodeURIComponent(location.hash.slice(1));&#xA;      var found = false;&#xA;      panels.forEach(function (p) {&#xA;        var on = p.id === id;&#xA;        p.hidden = !on;&#xA;        if (on) found = true;&#xA;      });&#xA;      home.hidden = found;&#xA;      back.hidden = !found;&#xA;      if (scroll) {&#xA;        var y = root.getBoundingClientRect().top + window.pageYOffset - 24;&#xA;        window.scrollTo({ top: Math.max(0, y), behavior: &#39;instant&#39; });&#xA;      }&#xA;    }&#xA;&#xA;    root.addEventListener(&#39;click&#39;, function (e) {&#xA;      var card = e.target.closest(&#39;.ab-card&#39;);&#xA;      if (card) { inPage = true; location.hash = card.dataset.id; return; }&#xA;      if (e.target.closest(&#39;.ab-back&#39;)) {&#xA;        if (inPage) {&#xA;          history.back();                       &#xA;        } else {                                &#xA;          history.replaceState(null, &#39;&#39;, location.pathname + location.search);&#xA;          sync(true);&#xA;        }&#xA;      }&#xA;    });&#xA;    window.addEventListener(&#39;hashchange&#39;, function () { sync(true); });&#xA;    sync(false);&#xA;&#xA;     &#xA;    var box   = root.querySelector(&#39;.ab-box&#39;);&#xA;    var track = box.querySelector(&#39;.ab-track&#39;);&#xA;    var ttl   = box.querySelector(&#39;.ab-ttl&#39;);&#xA;    var cap   = box.querySelector(&#39;.ab-cap&#39;);&#xA;    var prev  = box.querySelector(&#39;.ab-prev&#39;);&#xA;    var next  = box.querySelector(&#39;.ab-next&#39;);&#xA;    var items = [], album = &#39;&#39;, i = 0, raf = 0;&#xA;&#xA;    function update(n) {&#xA;      i = n;&#xA;      ttl.textContent = album + (items.length &gt; 1 ? &#39;  ·  &#39; + (n + 1) + &#39; / &#39; + items.length : &#39;&#39;);&#xA;      cap.textContent = items[n].cap;&#xA;      prev.disabled = n === 0;&#xA;      next.disabled = n === items.length - 1;&#xA;    }&#xA;&#xA;    function goTo(n, smooth) {&#xA;      n = Math.max(0, Math.min(items.length - 1, n));&#xA;      track.scrollTo({ left: n * track.clientWidth, behavior: smooth ? &#39;smooth&#39; : &#39;instant&#39; });&#xA;      if (!smooth) update(n);&#xA;    }&#xA;&#xA;    root.addEventListener(&#39;click&#39;, function (e) {&#xA;      var a = e.target.closest(&#39;.ab-pic&#39;);&#xA;      if (!a) return;&#xA;      e.preventDefault();&#xA;      var panel = a.closest(&#39;.ab-album&#39;);&#xA;      var links = panel.querySelectorAll(&#39;.ab-pic&#39;);&#xA;      items = Array.prototype.map.call(links, function (l) {&#xA;        return { src: l.href, cap: l.dataset.cap };&#xA;      });&#xA;      album = panel.querySelector(&#39;.ab-title&#39;) ? panel.querySelector(&#39;.ab-title&#39;).textContent : &#39;&#39;;&#xA;      box.dataset.single = items.length &lt; 2 ? &#39;true&#39; : &#39;false&#39;;&#xA;&#xA;      track.innerHTML = &#39;&#39;;&#xA;      items.forEach(function (it) {&#xA;        var f = document.createElement(&#39;figure&#39;);&#xA;        f.className = &#39;ab-slide&#39;;&#xA;        var im = new Image();&#xA;        im.alt = it.cap;&#xA;        im.draggable = false;&#xA;        im.decoding = &#39;async&#39;;&#xA;        im.src = it.src;&#xA;        f.appendChild(im);&#xA;        track.appendChild(f);&#xA;      });&#xA;&#xA;      box.showModal();&#xA;      goTo(Array.prototype.indexOf.call(links, a), false);&#xA;    });&#xA;&#xA;    &#xA;    track.addEventListener(&#39;scroll&#39;, function () {&#xA;      cancelAnimationFrame(raf);&#xA;      raf = requestAnimationFrame(function () {&#xA;        if (!items.length) return;&#xA;        var n = Math.round(track.scrollLeft / track.clientWidth);&#xA;        if (n !== i &amp;&amp; items[n]) update(n);&#xA;      });&#xA;    });&#xA;&#xA;    &#xA;    track.addEventListener(&#39;click&#39;, function (e) {&#xA;      if (e.target.tagName !== &#39;IMG&#39;) box.close();&#xA;    });&#xA;&#xA;    box.querySelector(&#39;.ab-x&#39;).addEventListener(&#39;click&#39;, function () { box.close(); });&#xA;    prev.addEventListener(&#39;click&#39;, function () { goTo(i - 1, true); });&#xA;    next.addEventListener(&#39;click&#39;, function () { goTo(i + 1, true); });&#xA;    box.addEventListener(&#39;keydown&#39;, function (e) {&#xA;      if (e.key === &#39;ArrowLeft&#39;)  goTo(i - 1, true);&#xA;      if (e.key === &#39;ArrowRight&#39;) goTo(i + 1, true);&#xA;    });&#xA;    box.addEventListener(&#39;close&#39;, function () { track.innerHTML = &#39;&#39;; items = []; });&#xA;    window.addEventListener(&#39;resize&#39;, function () { if (box.open &amp;&amp; items.length) goTo(i, false); });&#xA;  })();&#xA;  &lt;/script&gt;&#xA;&lt;/div&gt;</description>
